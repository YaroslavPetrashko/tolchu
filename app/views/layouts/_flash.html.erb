<% flash.each do |type, message| %>
  <% next unless message.is_a?(String) %>
  <div class="flash flash--<%= type == "alert" ? "alert" : "notice" %>" role="<%= type == "alert" ? "alert" : "status" %>" data-controller="flash">
    <span><%= message %></span>
    <button type="button" class="flash__close" data-action="flash#dismiss" aria-label="Dismiss">×</button>
  </div>
<% end %>
