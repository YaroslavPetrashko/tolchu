<% content_for :title, "Sign up" %>

<section class="auth-card">
  <h1>Join Tolchu</h1>
  <p class="muted">Get <strong><%= credits(User::STARTING_CREDITS) %></strong> free. Watch a clip, call what happens next, and win from the pool in seconds.</p>

  <%= form_with model: @user, url: registration_path, class: "stack-form" do |form| %>
    <%= render "shared/form_errors", record: @user %>

    <div class="field">
      <%= form.label :username %>
      <%= form.text_field :username, required: true, autocomplete: "username", maxlength: 20, autofocus: true %>
    </div>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autocomplete: "email" %>
    </div>
    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
      <p class="hint">At least 8 characters.</p>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, "Confirm password" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>

    <%= form.submit "Create account", class: "btn btn--primary btn--block" %>
  <% end %>

  <p class="auth-card__switch">Already have an account? <%= link_to "Sign in", new_session_path %></p>
</section>
